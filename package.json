{
  "name": "fixflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:postgres": "vitest run tests/integration --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "pilot:provision": "jiti scripts/provision-pilot.ts",
    "security:cleanup": "jiti scripts/security-cleanup.ts",
    "deploy:check": "jiti scripts/deploy-check.ts",
    "smoke:production": "jiti scripts/production-smoke.ts",
    "db:seed": "jiti prisma/seed.ts",
    "db:seed:demo": "jiti prisma/demo-seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format"
  },
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10 <11"
  },
  "dependencies": {
    "@prisma/client": "6.10.1",
    "bcryptjs": "3.0.2",
    "next": "16.2.12",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@types/node": "22.15.32",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "eslint": "9.29.0",
    "eslint-config-next": "16.2.12",
    "jiti": "2.4.2",
    "postcss": "8.5.26",
    "prisma": "6.10.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3",
    "vitest": "3.2.7"
  }
}
